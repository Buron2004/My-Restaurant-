generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum MealStatus {
  AVAILABLE
  OUT_OF_STOCK
  ARCHIVED
}

enum TableLocation {
  INDOOR
  OUTDOOR
  PRIVATE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
}

model Cuisine {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  imageUrl     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  meals        Meal[]
}

model Meal {
  id              String     @id @default(cuid())
  name            String
  description     String?
  price           Int
  cuisineId       String
  imageUrl        String?
  prepTimeMinutes Int
  status          MealStatus @default(AVAILABLE)
  dietaryTags     String[]
  isFeatured      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  cuisine         Cuisine    @relation(fields: [cuisineId], references: [id])

  @@index([cuisineId, status])
    orderItems  OrderItem[]
}

model Table {
  id           String        @id @default(cuid())
  name         String        @unique
  capacity     Int
  location     TableLocation
  isActive     Boolean       @default(true)
  reservations Reservation[]
}

model Reservation {
  id              String            @id @default(cuid())
  referenceCode   String            @unique
  guestName       String
  guestPhone      String
  guestEmail      String?
  partySize       Int
  reservationDate DateTime          @db.Date
  startTime       DateTime          @db.Time(6)
  endTime         DateTime          @db.Time(6)
  tableId         String
  specialRequests String?
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  table           Table             @relation(fields: [tableId], references: [id])

  @@index([reservationDate, tableId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
}

model DeliveryZone {
  id        String   @id @default(cuid())
  label     String
  zipPrefix String?
  fee       Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                  String        @id @default(cuid())
  referenceCode       String        @unique
  guestName           String
  guestPhone          String
  guestEmail          String?
  deliveryStreet      String
  deliveryCity        String
  deliveryZip         String?
  deliveryZoneLabel   String?
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus @default(UNPAID)
  status              OrderStatus   @default(PENDING)
  subtotal            Int
  deliveryFee         Int
  total               Int
  specialInstructions String?
  items               OrderItem[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mealId    String?
  meal      Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)
  mealName  String
  unitPrice Int
  quantity  Int

  @@index([orderId])
}
